VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=

# Canonical site origin for SEO (production build)
VITE_SITE_URL=https://motogearspitstop.com

# Optional Google Analytics 4 (do not commit real IDs in .env to public repos)
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel (browser). Conversions API access token goes in backend .env only.
# VITE_META_PIXEL_ID=

# Official YouTube channel (footer icon)
# VITE_YOUTUBE_URL=https://www.youtube.com/@YourChannel

# WhatsApp community invite link (defaults to the Motogears community group)
# VITE_WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/FnAHNpKug3MJ6G9dEenbxI

# After migrating Modern Tech images off disabled cloud `dbplgk8d8`, set your active cloud:
# VITE_CLOUDINARY_DELIVERY_CLOUD=dauynokmb
